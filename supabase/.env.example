# Supabase Edge Function secrets — set via: supabase secrets set KEY=value
# (these are never stored in .env files — this is reference only)

# Auto-injected by Supabase runtime — no need to set manually
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...

# Explee (GTM Sales Agent API)
# Master key used as fallback when a customer hasn't provided their own key.
# Obtain from: https://app.explee.com/settings/api-keys
# Set via Supabase MCP tool (list_edge_function_secrets / set secrets).
# NEVER expose this key client-side — it is only used in edge functions.
EXPLEE_MASTER_KEY=expl_master_...

# AI APIs
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
PERPLEXITY_API_KEY=pplx-...
XAI_API_KEY=xai-...

# Twitter
TWITTER_BEARER_TOKEN=AAAA...
